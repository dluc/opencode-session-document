{
  "name": "opencode-session-document",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A living, editable Markdown and Mermaid document for each OpenCode session",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dluc/opencode-session-document.git"
  },
  "exports": {
    ".": "./dist/server.js",
    "./rpc": "./dist/rpc.js",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist/server.js",
    "dist/rpc.js",
    "dist/gui-experimental.cjs",
    "dist/*.components.json",
    "dist/*.third-party.txt",
    "docs/images/session-document.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:gui": "vite build",
    "build:runtime": "vite build --config vite.runtime.config.ts && vite build --config vite.runtime.config.ts --mode rpc",
    "build:all": "npm run build:runtime && npm run build:gui",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/check-diagrams.mjs",
    "docs:screenshot": "node scripts/capture-readme.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm test && npm run build:all && npm run check:package"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.0",
    "dompurify": "^3.3.0",
    "effect": "^4.0.1",
    "marked": "^17.0.0",
    "mermaid": "^12.2.0",
    "zod": "^4.1.0",
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^5.0.5"
  }
}
