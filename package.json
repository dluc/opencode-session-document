{
  "name": "opencode-session-document",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A living, editable Markdown and Mermaid document for each OpenCode session",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/check-diagrams.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.0",
    "dompurify": "^3.3.0",
    "effect": "^4.0.1",
    "marked": "^17.0.0",
    "mermaid": "^12.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^5.0.5"
  }
}
